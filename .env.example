# 공개 가능한 환경변수 이름만 적는 예시 파일입니다.
#
# 로컬 개발: 이 파일을 `.env.local`로 복사한 뒤 본인 값으로 채우세요.
# Vercel: Project Settings > Environment Variables에 직접 등록하세요.
# 실제 키, 이메일, DB URL, 비밀번호가 든 `.env*` 파일은 Git/ZIP/메신저로 공유하지 마세요.

# Supabase Project URL
NEXT_PUBLIC_SUPABASE_URL=

# Supabase publishable key(`sb_publishable_...`) 권장.
# 변수명은 기존 코드 호환을 위해 ANON_KEY를 유지합니다. legacy anon key도 사용할 수 있습니다.
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# 서버 전용 Supabase secret key(`sb_secret_...`) 권장.
# 프로젝트에 secret key가 없다면 legacy service_role key를 사용합니다.
# 절대 NEXT_PUBLIC_ 접두사를 붙이지 마세요.
SUPABASE_SERVICE_ROLE_KEY=

# 매직 링크 redirect 기준 URL. 프로덕션은 최종 HTTPS URL을 사용합니다.
# 로컬 예: http://localhost:3000
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# 정식 호스트와 선택적 대체 호스트. scheme/path 없이 호스트명만 입력합니다.
# 예: NEXT_PUBLIC_CANONICAL_HOST=www.example.com
#     CANONICAL_REDIRECT_HOST=example.com
# Preview에서는 둘 다 비워 두어 프로덕션으로 강제 이동하지 않게 하세요.
NEXT_PUBLIC_CANONICAL_HOST=
CANONICAL_REDIRECT_HOST=

# Vercel Cron이 Authorization: Bearer <CRON_SECRET> 헤더로 사용합니다.
# 비밀번호 관리자로 32바이트 이상의 임의 값을 생성해 Vercel Production에만 저장하세요.
CRON_SECRET=

# soft delete 후 원본/썸네일을 물리 삭제할 때까지의 보존 일수
SOFT_DELETE_RETENTION_DAYS=30

# 직원 교육용 디자인 미리보기. true일 때만 /training-preview가 열립니다.
# 운영 환경에서는 false 또는 미설정으로 두어 404가 반환되게 하세요.
TRAINING_PREVIEW_ENABLED=false

# 인증서와 모든 서브도메인의 HTTPS가 확인된 뒤 Production에서만 true로 설정하세요.
# true로 빌드하면 HSTS(max-age=2년, includeSubDomains)가 응답에 추가됩니다.
ENABLE_HSTS=false
